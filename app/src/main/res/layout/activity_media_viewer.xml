<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewerRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#101116">

    <FrameLayout android:id="@+id/swipeSurface" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/imageView" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="Media preview"/>
        <VideoView android:id="@+id/videoView" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_gravity="center" android:visibility="gone"/>
        <LinearLayout android:id="@+id/audioPanel" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:orientation="vertical" android:visibility="gone">
            <TextView android:text="♪" android:textSize="72sp" android:textColor="#FFFFFF"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/mediaName" android:textColor="#FFFFFF" android:textSize="18sp"
                android:gravity="center" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/audioButton" android:text="Play" android:textAllCaps="false"
                android:layout_width="140dp" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/pdfPanel" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:paddingTop="72dp" android:paddingBottom="76dp"
            android:visibility="gone">
            <ImageView android:id="@+id/pdfPage" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:scaleType="fitCenter" android:background="#FFFFFF"
                android:contentDescription="PDF page"/>
            <TextView android:id="@+id/pageText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:padding="8dp" android:textColor="#FFFFFF" android:textSize="13sp"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="top"
        android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="#CC101116">
        <ImageButton android:id="@+id/closeButton" android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Close"
            android:layout_width="48dp" android:layout_height="48dp"/>
        <TextView android:id="@+id/titleText" android:textColor="#FFFFFF" android:textSize="16sp" android:maxLines="1"
            android:ellipsize="middle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:paddingStart="8dp" android:paddingEnd="4dp"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/countText" android:textColor="#FFFFFF" android:textSize="13sp"
            android:alpha="0.8" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <ImageButton android:id="@+id/rotateButton" android:src="@android:drawable/ic_menu_rotate" android:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Rotate"
            android:layout_width="48dp" android:layout_height="48dp"/>
        <ImageButton android:id="@+id/detailsButton" android:src="@android:drawable/ic_menu_info_details" android:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Details"
            android:layout_width="48dp" android:layout_height="48dp"/>
        <ImageButton android:id="@+id/shareButton" android:src="@android:drawable/ic_menu_share" android:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Share"
            android:layout_width="48dp" android:layout_height="48dp"/>
    </LinearLayout>
</FrameLayout>